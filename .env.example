# ============================================
# VELO LIVE - Environment Variables Template
# ============================================
# Kopieer dit bestand naar .env en vul de waardes in
# cp .env.example .env

# ============================================
# DATABASE
# ============================================
# Lokaal (Docker):
DATABASE_URL=postgresql://admin:Velo123@db:5432/velo_community

# Remote (Vercel/Production):
# DATABASE_URL=postgresql://user:password@your-host.com:5432/dbname
# Voorbeelden:
# - Supabase: postgresql://postgres:[YOUR-PASSWORD]@db.[PROJECT-REF].supabase.co:5432/postgres
# - Railway: postgresql://postgres:password@containers-us-west-xxx.railway.app:5432/railway
# - Neon: postgresql://user:password@ep-xxx.us-east-2.aws.neon.tech/neondb

# ============================================
# FLASK
# ============================================
# Genereer met: python -c "import secrets; print(secrets.token_urlsafe(32))"
SECRET_KEY=change-this-to-a-long-random-secret-key

# Optioneel (standaard: 8000)
PORT=8000

# ============================================
# STRIPE (Payment Provider)
# ============================================
# Test keys beginnen met sk_test_ en pk_test_
# Live keys beginnen met sk_live_ en pk_live_
STRIPE_SECRET_KEY=sk_test_your_stripe_secret_key
STRIPE_PUBLISHABLE_KEY=pk_test_your_stripe_publishable_key

# ============================================
# AUTH0 (Authentication)
# ============================================
# Haal deze op van je Auth0 dashboard
AUTH0_DOMAIN=your-domain.eu.auth0.com
AUTH0_CLIENT_ID=your_auth0_client_id
AUTH0_CLIENT_SECRET=your_auth0_client_secret

# ============================================
# AWS (Optioneel - voor S3 file uploads)
# ============================================
# AWS_ACCESS_KEY_ID=your_aws_access_key
# AWS_SECRET_ACCESS_KEY=your_aws_secret_key
# AWS_S3_BUCKET=your-bucket-name
# AWS_REGION=eu-west-1

# ============================================
# PGADMIN (Alleen voor Docker)
# ============================================
PGADMIN_DEFAULT_EMAIL=admin@velo.com
PGADMIN_DEFAULT_PASSWORD=admin123

# ============================================
# DATABASE CREDENTIALS (Alleen voor Docker)
# ============================================
POSTGRES_USER=admin
POSTGRES_PASSWORD=Velo123
POSTGRES_DB=velo_community
